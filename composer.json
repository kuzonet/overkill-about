{
    "name": "kuzonet/overkill-about",
    "description": "Display a nice configurable about screen for your FilamentPHP project",
    "keywords": [
        "kuzonet",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "overkill-about"
    ],
    "homepage": "https://github.com/kuzonet/overkill-about",
    "support": {
        "issues": "https://github.com/kuzonet/overkill-about/issues",
        "source": "https://github.com/kuzonet/overkill-about"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Joe Garvey",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.7 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Kuzonet\\OverkillAbout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kuzonet\\OverkillAbout\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "test": "pest --no-coverage",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kuzonet\\OverkillAbout\\OverkillAboutServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}